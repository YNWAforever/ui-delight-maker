# App URL used by n8n when calling app-owned context and writeback endpoints.
APP_BASE_URL=http://localhost:5173

# Neon Postgres - server-side only. Do not expose this through VITE_ vars.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Neon Auth - browser-safe auth URL from the Neon Auth integration.
VITE_NEON_AUTH_URL=https://YOUR_NEON_AUTH_URL

# Neon Auth - same URL for server-side session checks.
NEON_AUTH_URL=https://YOUR_NEON_AUTH_URL

# n8n - app triggers. Use separate URLs so each AI button can map to one workflow.
N8N_QUALIFY_LEAD_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/clientops-qualify-lead
N8N_DRAFT_REPLY_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/clientops-draft-reply
N8N_DRAFT_QUOTE_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/clientops-draft-quote

# Shared secret sent app -> n8n and n8n -> app.
N8N_WORKFLOW_TOKEN=replace-with-a-long-random-token

# Optional direct workflow apply. Leave unset when importing JSON manually.
N8N_API_BASE_URL=https://YOUR_N8N_HOST
N8N_API_KEY=replace-with-n8n-public-api-key

# Optional live AI path. Workflows must still pass with deterministic fallback.
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Staging smoke seed controls. Never point these at production.
CLIENTOPS_ALLOW_STAGING_SEED=0
CLIENTOPS_SEED_TARGET=staging
CLIENTOPS_SMOKE_PROFILE_ID=neon-auth-user-id-for-staging-user
CLIENTOPS_SMOKE_PROFILE_EMAIL=clientops-smoke@example.com
CLIENTOPS_SMOKE_PROFILE_NAME=ClientOps Smoke User
