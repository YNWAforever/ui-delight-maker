{
  "name": "clientops-retention-sweep",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "days" }] } },
      "id": "retention-sweep-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL + '/api/workflows/retention-sweep'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-workflow-token", "value": "={{$env.N8N_WORKFLOW_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {}
      },
      "id": "call-retention-sweep",
      "name": "Call Retention Sweep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Call Retention Sweep", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
