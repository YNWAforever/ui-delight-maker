*.local

# Environment variables
# `.env` is listed explicitly: Bun and Vite both load it by default, so it is the file a
# developer following either project's convention will put a real DATABASE_URL into, and
# `.env*.local` does not match it.
.env
.env.*
!.env.example
!.env.local.example
.env.local
.env*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Frontend revision workspace
# Screenshots are shared through the PR, not the repository.
docs/frontend-revision/screenshots/
# Baseline gate transcripts are evidence and must be tracked despite the global *.log rule.
!docs/frontend-revision/baseline/*.log
